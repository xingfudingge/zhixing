# 端口与数据库
PORT=8787
HOST=0.0.0.0
DATABASE_URL=postgres://zhixing:zhixing@localhost:5432/zhixing

# 首次初始化。生产环境请替换为随机值，并保持 setup 只允许本机访问。
ZX_SETUP_TOKEN=dev-setup-token
ZX_SETUP_ALLOW_REMOTE=false

# 令牌生命周期（秒）
ZX_ACCESS_TTL=86400
ZX_REFRESH_TTL=2592000
ZX_PAIRING_TTL=600
ZX_ADMIN_SESSION_TTL=43200
ZX_MAX_DEVICES=20

# MinIO / S3
ZX_S3_ENDPOINT=http://localhost:9000
# 客户端可访问的地址（Docker 内为 http://minio:9000，宿主机为 http://localhost:9000）
ZX_S3_PUBLIC_ENDPOINT=http://localhost:9000
ZX_S3_REGION=us-east-1
ZX_S3_BUCKET=zhixing
ZX_S3_ACCESS_KEY=minioadmin
ZX_S3_SECRET_KEY=minioadmin
ZX_S3_FORCE_PATH_STYLE=true
ZX_S3_AUTO_CREATE_BUCKET=true

# 反向代理后请设为 true，并只把 8787 暴露给 nginx
ZX_TRUST_PROXY=false
ZX_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://tauri.localhost,tauri://localhost
